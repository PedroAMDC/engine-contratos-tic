# Copie para .env e preencha. O .env não vai para o git.

# IDs do Google Drive (parte final do link da pasta ou planilha)
PASTA_CONTRATOS=
PASTA_RELATORIOS=
PLANILHA_ORGAOS=
SUBPASTA_RELATORIOS=3_CONTRATOS_TIC

# Pastas sincronizadas pelo Google Drive para desktop
